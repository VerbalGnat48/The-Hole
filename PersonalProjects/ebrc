FIND()
{
	if [ "${1}" = "PCT" ]; then
		cd > /dev/null && cd ~/src/fall2024/pct/ > /dev/null
		if [ -z "${2}" ]; then
			ls ;
		else
			cd pct"${2}";
		fi
	elif [ -z "${2}" ]; then
		cd > /dev/null && cd $( ls -lR | grep -m 1 "/[A-Za-z0-9-]*${1}" | sed 's/.$//' );
	elif [ "${2}" = "P" ]; then
		cd /mnt/c/Users/cmazz/OneDrive/Pictures > /dev/null && cd $( ls -lR | grep -m 1 "/[A-Za-z0-9-]*${1}" | sed 's/.$//' ) ;
	elif [ "${2}" = "C" ]; then
		cd /mnt/c/Users/cmazz > /dev/null && cd $( ls | grep "${1}" ) ;
	elif [ "${2}" = "J" ]; then
		cd /mnt/c/Users/cmazz/CSCS2420F24 > /dev/null && cd $( ls | grep "${1}" ) ;
	fi

}
alias ct='FIND'

PLAY()
{
	#sudo apt install sox
	#sudo apt intsall libsox-fmt-all
	cd /mnt/c/Users/cmazz/Music/Sound_Effects > /dev/null ;
	play -q $(ls | grep "${1}" ) ;
	if [[ -n "$2" ]]
	then
		play -q $( ls | grep "${2}" )	
	fi
	cd - > /dev/null ;
}
alias Play='PLAY'

